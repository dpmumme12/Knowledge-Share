# Production environment variables for config.settings.prd
# See docs/environment.md for the full reference, including the
# dev_env.json keys used by config.settings.dev (which differ from
# these names) and the CI-only settings module.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Database (Postgres)
DATABASE_NAME=knowledgeshare
DATABASE_USER=knowledgeshare
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost

# Cloudinary (user-uploaded media storage)
# NOTE: these names were previously mistyped as ClOUDINARY_* (lowercase l) —
# use the CLOUDINARY_* casing below.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (SMTP via Gmail)
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_TO_EMAIL=you@example.com

# Logging
LOG_LEVEL=INFO
